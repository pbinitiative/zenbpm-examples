        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_0ls8ktv" sourceRef="TICE_CustomerAcceptsOfferTimeout" targetRef="ActivST_SendReminderViaMail" />
