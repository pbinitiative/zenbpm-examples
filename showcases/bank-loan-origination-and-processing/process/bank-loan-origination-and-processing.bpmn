        <bpmn:incoming>Flow_0p8dd40</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0p8dd40" sourceRef="ActivST_SendReminderViaMail" targetRef="EE_ReminderSent" />
      <bpmn:sequenceFlow id="Flow_0gqsjxl" sourceRef="SE_CustomerResponseProcessStarted" targetRef="EBG_CustomerOfferAccepted" />
      <bpmn:endEvent id="EveEE_CustomerResponseReceived" name="customer response received">
