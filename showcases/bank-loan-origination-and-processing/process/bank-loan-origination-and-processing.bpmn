      <bpmn:eventBasedGateway id="EBG_CustomerOfferAccepted">
        <bpmn:incoming>Flow_0gqsjxl</bpmn:incoming>
        <bpmn:incoming>Flow_15hwrj0</bpmn:incoming>
        <bpmn:outgoing>Flow_10yby69</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sequenceFlow id="Flow_1y9xwy6" sourceRef="UT_CustomerAcceptsOffer" targetRef="EveEE_CustomerResponseReceived" />
      <bpmn:intermediateCatchEvent id="TICE_CustomerAcceptsOfferTimeout" name="60 seconds">
        <bpmn:incoming>Flow_10yby69</bpmn:incoming>
        <bpmn:outgoing>Flow_0ls8ktv</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0barawi">
