    <bpmn:messageFlow id="Flow_0fjmg5w" sourceRef="P_BankITSystem" targetRef="ST_ProvideLoan" />
    <bpmn:messageFlow id="Flow_1cbc0uc" sourceRef="P_BankITSystem" targetRef="ST_ValidateDataAndCreateTicket" />
    <bpmn:messageFlow id="Flow_1dvv0re" sourceRef="ST_RecordDeclinedLoanApplication" targetRef="P_BankITSystem" />
    <bpmn:messageFlow id="Flow_1ntmeqf" sourceRef="ST_SendOffer" targetRef="P_Customer" />
