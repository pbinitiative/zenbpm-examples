    <bpmn:messageFlow id="Flow_1c7ohtr" sourceRef="P_Customer" targetRef="P_Chatbot" />
    <bpmn:messageFlow id="Flow_0kny3xj" sourceRef="P_Chatbot" targetRef="P_Customer" />
    <bpmn:messageFlow id="Flow_1rbcc7e" sourceRef="P_Customer" targetRef="P_Chatbot" />
    <bpmn:messageFlow id="Flow_1ntqrd8" sourceRef="P_Chatbot" targetRef="P_Customer" />
    <bpmn:textAnnotation id="TextAnnotation_loan_origination_intro">
      <bpmn:text>Triggered when a customer submits a loan application via the bank chatbot. The happy-path outcome is the loan approved and the customer notified via the bank's systems.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_loan_origination_intro" associationDirection="None" sourceRef="SE_LoanRequested" targetRef="TextAnnotation_loan_origination_intro" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Loan_Origination_And_Processing" name="Bank: Loan origination and processing" isExecutable="true">
    <bpmn:startEvent id="SE_LoanRequested" name="Loan requested">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_16l6p9i" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;address&#34;: {&#10;    &#34;first_name&#34;: &#34;Laya&#34;,&#10;    &#34;last_name&#34;: &#34;Williams&#34;,&#10;    &#34;address_1&#34;: &#34;123 Anywhere Dr&#34;,&#10;    &#34;address_2&#34;: &#34;&#34;,&#10;    &#34;city&#34;: &#34;Raleigh&#34;,&#10;    &#34;zip_code&#34;: &#34;27697&#34;,&#10;    &#34;state&#34;: &#34;North Carolina&#34;,&#10;    &#34;country&#34;: &#34;USA&#34;&#10;  },&#10;  &#34;contact&#34;: {&#10;    &#34;email&#34;: &#34;laya.williams@mail.mail&#34;,&#10;    &#34;phone&#34;: &#34;+4930664040900&#34;,&#10;    &#34;mobile&#34;: &#34;+4930664040900&#34;&#10;  },&#10;  &#34;pi&#34;: {&#10;    &#34;ssn&#34;: &#34;134-31-1679&#34;,&#10;    &#34;date_of_birth&#34;: null,&#10;    &#34;annual_salary&#34;: 55200,&#10;    &#34;current_employer&#34;: &#34;Styles and Speed Printing LLC.&#34;&#10;  },&#10;  &#34;loan&#34;: {&#10;    &#34;amount&#34;: 25000,&#10;    &#34;tenure&#34;: 36&#10;  }&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1myqvj5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_ValidateDataAndCreateTicket" name="Validate data and create ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate_data" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;ticketId&#34;: 123&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mmizy1</bpmn:incoming>
      <bpmn:outgoing>Flow_0qw7cmq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_GetCreditScore" name="Get credit score">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="getCreditScore" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;creditScore&#34;: 760&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1myqvj5</bpmn:incoming>
      <bpmn:outgoing>Flow_1mmizy1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SP_LoanProcessing" name="Loan processing">
      <bpmn:incoming>Flow_0qw7cmq</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2sxpr</bpmn:outgoing>
      <bpmn:businessRuleTask id="BRE_CalculateLoanResults" name="Calculate loan results">
        <bpmn:extensionElements>
          <zeebe:calledDecision decisionId="calculate_loan_results_01uhf55" resultVariable="loan_results" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0f5fqcz</bpmn:incoming>
        <bpmn:outgoing>Flow_075y3tx</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="Gateway_0z4748g" name="Loan results?" default="Flow_1dh4tok">
        <bpmn:incoming>Flow_075y3tx</bpmn:incoming>
        <bpmn:outgoing>Flow_0l1o42y</bpmn:outgoing>
        <bpmn:outgoing>Flow_00qm36p</bpmn:outgoing>
        <bpmn:outgoing>Flow_1dh4tok</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_024n1nl" name="loan declined manually">
        <bpmn:documentation>EEE_LoanDeclinedManually</bpmn:documentation>
        <bpmn:incoming>Flow_02lqgsk</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0554m4g" errorRef="Error_1waf4p2" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_0qv5443" name="Underwriting result?">
        <bpmn:incoming>Flow_0cprzim</bpmn:incoming>
        <bpmn:outgoing>Flow_02lqgsk</bpmn:outgoing>
        <bpmn:outgoing>Flow_01k4abh</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_UnderwriteLoan" name="Underwrite loan">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="Form_1a3j1g2" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_00qm36p</bpmn:incoming>
        <bpmn:outgoing>Flow_0cprzim</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sendTask id="ST_SendOfferToChatbot" name="Send offer to chatbot">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="chatbot_message" />
          <zeebe:ioMapping>
            <zeebe:input source="=&#34;approval_and_offer&#34;" target="type" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0l1o42y</bpmn:incoming>
        <bpmn:outgoing>Flow_1k23v95</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sendTask id="ST_SendRejectionToChatbot" name="Send rejection to chatbot">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="chatbot_message" />
          <zeebe:ioMapping>
            <zeebe:input source="=&#34;rejection&#34;" target="type" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1dh4tok</bpmn:incoming>
        <bpmn:outgoing>Flow_0aox6tt</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="EE_LoanDeclinedAutomatically" name="loan declined automatically">
        <bpmn:incoming>Flow_0aox6tt</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0wn74xl" errorRef="Error_1waf4p2" />
      </bpmn:endEvent>
      <bpmn:endEvent id="EE_LoanApprovedAutomatically" name="loan approved automatically">
        <bpmn:incoming>Flow_1k23v95</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="EE_LoanApprovedManually" name="loan approved manually">
        <bpmn:incoming>Flow_01k4abh</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_075y3tx" sourceRef="BRE_CalculateLoanResults" targetRef="Gateway_0z4748g" />
      <bpmn:sequenceFlow id="Flow_0l1o42y" name="approve automatically" sourceRef="Gateway_0z4748g" targetRef="ST_SendOfferToChatbot">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loan_results.isLoanEligible and not(loan_results.sendToUnderwriter)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_00qm36p" name="send to underwriter" sourceRef="Gateway_0z4748g" targetRef="UT_UnderwriteLoan">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loan_results.sendToUnderwriter</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1dh4tok" name="decline automatically" sourceRef="Gateway_0z4748g" targetRef="ST_SendRejectionToChatbot" />
      <bpmn:sequenceFlow id="Flow_02lqgsk" name="declined" sourceRef="Gateway_0qv5443" targetRef="Event_024n1nl">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(approve_loan)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0cprzim" sourceRef="UT_UnderwriteLoan" targetRef="Gateway_0qv5443" />
      <bpmn:sequenceFlow id="Flow_01k4abh" name="approved" sourceRef="Gateway_0qv5443" targetRef="EE_LoanApprovedManually">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approve_loan</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1k23v95" sourceRef="ST_SendOfferToChatbot" targetRef="EE_LoanApprovedAutomatically" />
      <bpmn:sequenceFlow id="Flow_0aox6tt" sourceRef="ST_SendRejectionToChatbot" targetRef="EE_LoanDeclinedAutomatically" />
      <bpmn:startEvent id="SE_LoanProcessingStarted" name="loan processing started">
        <bpmn:outgoing>Flow_0f5fqcz</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0f5fqcz" sourceRef="SE_LoanProcessingStarted" targetRef="BRE_CalculateLoanResults" />
    </bpmn:subProcess>
    <bpmn:sendTask id="ST_SendOffer" name="Send offer via mail">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email_notification" />
        <zeebe:ioMapping>
