<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.12</version>
        <relativePath/>
    </parent>

    <groupId>eu.bpm4</groupId>
    <artifactId>bank-loan-worker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>bank-loan-worker</name>
    <description>Spring Boot worker application for bank loan origination and processing</description>

    <properties>
        <java.version>21</java.version>
        <zenbpm-java-client.version>v0.3.9</zenbpm-java-client.version>
    </properties>

    <!--
        Override the OpenTelemetry version managed by Spring Boot 3.3.x.
        The zenbpm-spring-boot-starter requires OTel 1.58.0, which is newer
        than what this Spring Boot release manages.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>1.58.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.zenbpm</groupId>
            <artifactId>zenbpm-spring-boot-starter</artifactId>
            <version>${zenbpm-java-client.version}</version>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>1.78.0</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github-zenbpm-java-client</id>
            <url>https://maven.pkg.github.com/pbinitiative/zenbpm-java-client</url>
        </repository>
    </repositories>

    <!--
        spring-boot-maven-plugin is inherited from spring-boot-starter-parent
        and already configured with the repackage goal — no explicit declaration needed.
    -->
</project>
