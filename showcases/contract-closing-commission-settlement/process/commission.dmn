<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:modeler="http://camunda.org/schema/modeler/1.0"
             id="DRD_commission" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler"
             exporterVersion="5.33.1" modeler:executionPlatform="Camunda Cloud"
             modeler:executionPlatformVersion="8.6.0">

  <!--
Commission decision: clientRegion × contractValue × contractType × paymentTerms  (48 rules)

Base rates by region (low < 10 000 / high >= 10 000):
North America : 5 % / 10 %   paymentTerms: ignored
APAC          : 4 % /  9 %   paymentTerms: ignored
LATAM         : 3 % /  8 %   paymentTerms: ignored
EMEA          : see below    paymentTerms: applied

Contract-type bonus on top of base:
standard   : +0 %
framework  : +2 %
individual : +3 %

EMEA payment-terms adjustment on top of base+type:
prepayment : +1 %   (best cash flow for company)
net30      :  0 %
net60      :  0 %
net90      : -1 %   (delayed payment risk)
milestone  :  0 %
-->
  <decision id="DMN_salesperson_commission" name="Setting the salesperson's commission">
    <decisionTable id="DecisionTable_commission" hitPolicy="UNIQUE">

      <input id="InputClause_region" label="Client Region">
        <inputExpression id="LE_region" typeRef="string">
          <text>clientRegion</text>
        </inputExpression>
      </input>
      <input id="InputClause_value" label="Contract Value">
        <inputExpression id="LE_value" typeRef="number">
          <text>contractValue</text>
        </inputExpression>
      </input>
      <input id="InputClause_type" label="Contract Type">
        <inputExpression id="LE_type" typeRef="string">
          <text>contractType</text>
        </inputExpression>
      </input>
      <input id="InputClause_payment" label="Payment Terms">
        <inputExpression id="LE_payment" typeRef="string">
          <text>paymentTerms</text>
        </inputExpression>
      </input>

      <output id="OutputClause_commission" label="Commission" name="commission" typeRef="number"/>
      <output id="OutputClause_approval" label="Approval Required" name="approvalRequired" typeRef="boolean"/>

      <!-- ═══════════════════════════════════════════════════
NORTH AMERICA  —  paymentTerms: any (empty = wildcard)
═══════════════════════════════════════════════════ -->
      <rule id="R_NA_std_low">
        <inputEntry id="I_NA_std_low_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_std_low_v">
          <text>&lt; 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_std_low_t">
          <text>"standard"</text>
        </inputEntry>
        <inputEntry id="I_NA_std_low_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_std_low">
          <text>contractValue * 0.05</text>
        </outputEntry>
        <outputEntry id="OA_NA_std_low">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="R_NA_std_high">
        <inputEntry id="I_NA_std_high_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_std_high_v">
          <text>>= 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_std_high_t">
          <text>"standard"</text>
        </inputEntry>
        <inputEntry id="I_NA_std_high_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_std_high">
          <text>contractValue * 0.10</text>
        </outputEntry>
        <outputEntry id="OA_NA_std_high">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="R_NA_frm_low">
        <inputEntry id="I_NA_frm_low_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_low_v">
          <text>&lt; 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_low_t">
          <text>"framework"</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_low_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_frm_low">
          <text>contractValue * 0.07</text>
        </outputEntry>
        <outputEntry id="OA_NA_frm_low">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="R_NA_frm_high">
        <inputEntry id="I_NA_frm_high_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_high_v">
          <text>>= 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_high_t">
          <text>"framework"</text>
        </inputEntry>
        <inputEntry id="I_NA_frm_high_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_frm_high">
          <text>contractValue * 0.12</text>
        </outputEntry>
        <outputEntry id="OA_NA_frm_high">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="R_NA_ind_low">
        <inputEntry id="I_NA_ind_low_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_low_v">
          <text>&lt; 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_low_t">
          <text>"individual"</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_low_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_ind_low">
          <text>contractValue * 0.08</text>
        </outputEntry>
        <outputEntry id="OA_NA_ind_low">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="R_NA_ind_high">
        <inputEntry id="I_NA_ind_high_r">
          <text>"North America"</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_high_v">
          <text>>= 10000</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_high_t">
          <text>"individual"</text>
        </inputEntry>
        <inputEntry id="I_NA_ind_high_p">
          <text></text>
        </inputEntry>
        <outputEntry id="O_NA_ind_high">
          <text>contractValue * 0.13</text>
        </outputEntry>
        <outputEntry id="OA_NA_ind_high">
          <text>false</text>
        </outputEntry>
      </rule>

