      <!-- ═══════════════════════════════════════════════════
EMEA  —  paymentTerms matters
Base rates: standard 5/10 %, framework 7/12 %, individual 8/13 %
prepayment +1 %, net90 -1 %, net30/net60/milestone 0 %
═══════════════════════════════════════════════════ -->

      <!-- EMEA · standard · prepayment (+1 %) -->
      <rule id="R_EMEA_std_pre_low">
        <inputEntry id="I_EMEA_std_pre_low_r">
          <text>"EMEA"</text>
        </inputEntry>
        <inputEntry id="I_EMEA_std_pre_low_v">
          <text>&lt; 10000</text>
        </inputEntry>
        <inputEntry id="I_EMEA_std_pre_low_t">
