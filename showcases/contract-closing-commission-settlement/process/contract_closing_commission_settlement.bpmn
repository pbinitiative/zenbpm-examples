<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zenbpm="http://zenbpm.pbinitiative.org/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_14ej2l1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.33.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:collaboration id="Collaboration_1v5zv9b">
    <bpmn:participant id="Participant_1kokkss" name="Client" />
    <bpmn:participant id="Participant_09fhcid" name="Happy Company Ltd." processRef="Process_Contract_Closing" />
    <bpmn:messageFlow id="Flow_1rxyimv" name="E-Mail" sourceRef="ST_SendContractToClient" targetRef="Participant_1kokkss" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Contract_Closing" name="Contract Closing &#38; Commission Settlement" isExecutable="true">
    <bpmn:laneSet id="LaneSet_12n6vz3">
      <bpmn:lane id="Lane_Salesmen" name="Salesmen">
        <bpmn:flowNodeRef>UT_CreateContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_SendContractToClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_DetermineCommission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ApprovalRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ShowCommission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_ContractRegistered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SA_ProposalAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Director">
        <bpmn:flowNodeRef>UT_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ManagerApproval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_0bmozq6" sourceRef="SA_ProposalAccepted" targetRef="UT_CreateContract" />
    <bpmn:sequenceFlow id="Flow_1p25qj2" sourceRef="UT_CreateContract" targetRef="UT_SignContract" />
    <bpmn:sequenceFlow id="Flow_126k7yc" sourceRef="UT_SignContract" targetRef="ST_SendContractToClient" />
    <bpmn:sequenceFlow id="Flow_13lsbot" sourceRef="ST_SendContractToClient" targetRef="BRT_DetermineCommission" />
    <bpmn:sequenceFlow id="Flow_0dvanp3" sourceRef="BRT_DetermineCommission" targetRef="GW_ApprovalRequired" />
    <bpmn:sequenceFlow id="Flow_needs_approval" name="Yes" sourceRef="GW_ApprovalRequired" targetRef="UT_ManagerApproval">
      <bpmn:conditionExpression>=commission.approvalRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no_approval" name="No" sourceRef="GW_ApprovalRequired" targetRef="UT_ShowCommission">
      <bpmn:conditionExpression>=not(commission.approvalRequired)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_approval_done" sourceRef="UT_ManagerApproval" targetRef="UT_ShowCommission" />
    <bpmn:sequenceFlow id="Flow_0ppo514" sourceRef="UT_ShowCommission" targetRef="EE_ContractRegistered" />
    <bpmn:userTask id="UT_CreateContract" name="Create the contract">
      <bpmn:extensionElements>
        <zenbpm:userTask />
        <zenbpm:ioMapping>
          <zenbpm:output source="=accountManager" target="accountManager" />
          <zenbpm:output source="=clientName" target="clientName" />
          <zenbpm:output source="=clientRegion" target="clientRegion" />
          <zenbpm:output source="=contractType" target="contractType" />
          <zenbpm:output source="=contractValue" target="contractValue" />
          <zenbpm:output source="=paymentTerms" target="paymentTerms" />
          <zenbpm:output source="=subject" target="subject" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bmozq6</bpmn:incoming>
      <bpmn:outgoing>Flow_1p25qj2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_SendContractToClient" name="Send the contract to client">
      <bpmn:extensionElements>
        <zenbpm:taskDefinition type="send-contract-to-client" />
        <zenbpm:ioMapping>
          <zenbpm:output source="=accountManager" target="accountManager" />
          <zenbpm:output source="=clientName" target="clientName" />
          <zenbpm:output source="=clientRegion" target="clientRegion" />
          <zenbpm:output source="=contractType" target="contractType" />
          <zenbpm:output source="=contractValue" target="contractValue" />
          <zenbpm:output source="=paymentTerms" target="paymentTerms" />
          <zenbpm:output source="=subject" target="subject" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_126k7yc</bpmn:incoming>
      <bpmn:outgoing>Flow_13lsbot</bpmn:outgoing>
      <bpmn:property id="Property_1dk1gyr" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_074dpm5">
        <bpmn:sourceRef>DataObjectReference_0xlu6xa</bpmn:sourceRef>
        <bpmn:targetRef>Property_1dk1gyr</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DataObjectReference_0xlu6xa" name="Contract" dataObjectRef="DataObject_0jayppx" />
    <bpmn:dataObject id="DataObject_0jayppx" />
    <bpmn:businessRuleTask id="BRT_DetermineCommission" name="Determine the commission">
      <bpmn:extensionElements>
        <zenbpm:calledDecision decisionId="DMN_salesperson_commission" resultVariable="commission" />
        <zenbpm:ioMapping>
          <zenbpm:output source="=commission" target="commission" />
        </zenbpm:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13lsbot</bpmn:incoming>
      <bpmn:outgoing>Flow_0dvanp3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_ApprovalRequired" name="Approval required?">
      <bpmn:incoming>Flow_0dvanp3</bpmn:incoming>
      <bpmn:outgoing>Flow_needs_approval</bpmn:outgoing>
      <bpmn:outgoing>Flow_no_approval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_ShowCommission" name="Show commission">
      <bpmn:extensionElements>
        <zenbpm:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_no_approval</bpmn:incoming>
      <bpmn:incoming>Flow_approval_done</bpmn:incoming>
      <bpmn:outgoing>Flow_0ppo514</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EE_ContractRegistered" name="Contract registered">
      <bpmn:incoming>Flow_0ppo514</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_SignContract" name="Electronically sign the contract">
      <bpmn:extensionElements>
        <zenbpm:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1p25qj2</bpmn:incoming>
      <bpmn:outgoing>Flow_126k7yc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_ManagerApproval" name="Approve the commission">
      <bpmn:extensionElements>
        <zenbpm:userTask />
        <zenbpm:ioMapping />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_needs_approval</bpmn:incoming>
      <bpmn:outgoing>Flow_approval_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="SA_ProposalAccepted" name="Client accepted the proposal">
      <bpmn:outgoing>Flow_0bmozq6</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
